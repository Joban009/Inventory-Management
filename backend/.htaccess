Options -Indexes
DirectoryIndex index.php

# ─── Enable Rewrite Engine ────────────────────────────────────────────────────
RewriteEngine On

# ─── Handle OPTIONS preflight FIRST (before anything else) ───────────────────
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# ─── CORS — add your actual domains here ─────────────────────────────────────
# Allow both https://joban.com.np and https://www.joban.com.np if used by the frontend.
SetEnvIfNoCase Origin "^https?://(www\.)?joban\.com\.np(:[0-9]+)?$" CORS_ORIGIN=$0
SetEnvIfNoCase Origin "^https?://localhost(:[0-9]+)?$"              CORS_ORIGIN=$0

Header always set Access-Control-Allow-Origin    "%{CORS_ORIGIN}e" env=CORS_ORIGIN
Header always set Access-Control-Allow-Credentials "true"
Header always set Access-Control-Allow-Methods  "GET, POST, PUT, DELETE, OPTIONS"
Header always set Access-Control-Allow-Headers  "Content-Type, Authorization, X-Requested-With"
Header always set Vary "Origin"

# ─── Explicitly allow all HTTP methods to PHP files ──────────────────────────
<FilesMatch "\.php$">
    <LimitExcept GET POST PUT DELETE OPTIONS PATCH>
        Require all granted
    </LimitExcept>
</FilesMatch>

# ─── Make sure PHP files are executed (not downloaded) ───────────────────────
<FilesMatch "\.php$">
    SetHandler application/x-httpd-php
</FilesMatch>
